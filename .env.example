# Environment Configuration for Flashcard App

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Neon PostgreSQL Database
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/flashcard_db?sslmode=require

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Admin bootstrap (optional)
# Comma-separated list of emails that are always treated as admins.
# Use this to create the first admin; afterwards admins can promote others from /admin.
ADMIN_EMAILS=you@example.com
